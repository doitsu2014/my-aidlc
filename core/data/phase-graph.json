{
  "schemaVersion": "1.2.0",
  "modelAliases": ["opus", "sonnet", "haiku", "fable"],
  "phases": [
    {"id": "analyze", "name": "Analyze", "order": 1, "gate": "analysis-baseline", "file": "methodology/phases/analyze.md", "agents": ["brief-analyst", "context-risk-analyst"], "stages": ["problem-framing", "context-and-risk"]},
    {"id": "ideate", "name": "Ideate", "order": 2, "gate": "solution-direction", "file": "methodology/phases/ideate.md", "agents": ["solution-explorer", "decision-facilitator"], "stages": ["option-generation", "direction-selection"]},
    {"id": "develop", "name": "Develop", "order": 3, "gate": "release-candidate", "file": "methodology/phases/develop.md", "agents": ["implementation-planner", "builder-verifier"], "stages": ["implementation-design", "red-tests", "build-and-verify"]},
    {"id": "launch", "name": "Launch", "order": 4, "gate": "launch-and-handoff", "file": "methodology/phases/launch.md", "agents": ["release-coordinator", "operations-handoff"], "stages": ["release-readiness", "operational-handoff"]},
    {"id": "curate", "name": "Curate", "order": 5, "gate": "closure", "file": "methodology/phases/curate.md", "agents": ["outcome-curator", "knowledge-steward"], "stages": ["outcome-review", "knowledge-maintenance"]},
    {"id": "archived", "name": "Archived", "order": 6, "gate": "intent-closure", "file": "methodology/phases/archived.md", "agents": ["record-keeper", "knowledge-archivist"], "stages": ["intent-record", "knowledge-writeback"]}
  ],
  "stages": [
    {"id": "problem-framing", "phase": "analyze", "order": 1, "agent": "brief-analyst", "inputs": {"artifacts": [], "context": ["request", "project", "sources", "knowledge", "profile", "repos"]}, "produces": ["problem-statement", "success-measures", "stakeholder-map", "acceptance-criteria"]},
    {"id": "context-and-risk", "phase": "analyze", "order": 2, "agent": "context-risk-analyst", "inputs": {"artifacts": ["problem-statement", "success-measures", "stakeholder-map", "acceptance-criteria"], "context": ["request", "project", "sources", "knowledge", "profile", "repos"]}, "produces": ["constraints-and-assumptions", "evidence-log", "risk-register", "open-questions"]},
    {"id": "option-generation", "phase": "ideate", "order": 1, "agent": "solution-explorer", "inputs": {"artifacts": ["problem-statement", "success-measures", "stakeholder-map", "acceptance-criteria", "constraints-and-assumptions", "evidence-log", "risk-register", "open-questions"], "context": ["request", "project", "sources", "knowledge", "profile", "repos"]}, "produces": ["solution-options", "trade-off-matrix"]},
    {"id": "direction-selection", "phase": "ideate", "order": 2, "agent": "decision-facilitator", "inputs": {"artifacts": ["solution-options", "trade-off-matrix", "problem-statement", "success-measures", "stakeholder-map", "acceptance-criteria", "constraints-and-assumptions", "evidence-log", "risk-register", "open-questions"], "context": ["request", "project", "sources", "knowledge", "profile", "repos"]}, "produces": ["recommended-direction", "decision-record", "scope-boundary", "architecture-design"]},
    {"id": "implementation-design", "phase": "develop", "order": 1, "agent": "implementation-planner", "inputs": {"artifacts": ["recommended-direction", "decision-record", "scope-boundary", "architecture-design", "acceptance-criteria", "constraints-and-assumptions", "risk-register"], "context": ["request", "project", "sources", "profile", "repos"]}, "produces": ["implementation-plan", "interfaces-and-contracts", "functional-design"]},
    {"id": "red-tests", "phase": "develop", "order": 2, "agent": "builder-verifier", "inputs": {"artifacts": ["implementation-plan", "interfaces-and-contracts", "functional-design", "acceptance-criteria"], "context": ["request", "project", "sources", "profile", "repos"]}, "produces": ["failing-tests", "red-evidence"]},
    {"id": "build-and-verify", "phase": "develop", "order": 3, "agent": "builder-verifier", "inputs": {"artifacts": ["implementation-plan", "interfaces-and-contracts", "functional-design", "acceptance-criteria", "failing-tests", "red-evidence"], "context": ["request", "project", "sources", "profile", "repos"]}, "produces": ["implementation", "green-verification-report", "known-limitations"]},
    {"id": "release-readiness", "phase": "launch", "order": 1, "agent": "release-coordinator", "inputs": {"artifacts": ["implementation", "green-verification-report", "known-limitations"], "context": ["request", "project", "sources"]}, "produces": ["release-checklist", "deployment-and-rollback-plan", "communications-draft"]},
    {"id": "operational-handoff", "phase": "launch", "order": 2, "agent": "operations-handoff", "inputs": {"artifacts": ["release-checklist", "deployment-and-rollback-plan", "communications-draft"], "context": ["request", "project", "sources"], "external": ["support-context"]}, "produces": ["launch-record", "monitoring-and-support-ownership", "handoff-record"]},
    {"id": "outcome-review", "phase": "curate", "order": 1, "agent": "outcome-curator", "inputs": {"artifacts": ["success-measures", "decision-record", "launch-record"], "context": ["request", "project"], "external": ["observed-outcomes"]}, "produces": ["outcome-summary", "lessons-learned", "follow-up-register"]},
    {"id": "knowledge-maintenance", "phase": "curate", "order": 2, "agent": "knowledge-steward", "inputs": {"artifacts": ["outcome-summary", "lessons-learned", "follow-up-register", "decision-record", "known-limitations"], "context": ["request", "project", "knowledge"]}, "produces": ["curated-project-record", "retention-and-access-notes", "closure-recommendation"]},
    {"id": "intent-record", "phase": "archived", "order": 1, "agent": "record-keeper", "inputs": {"artifacts": ["*"], "context": ["request"]}, "produces": ["intent-summary", "completed-scope", "artifact-index"]},
    {"id": "knowledge-writeback", "phase": "archived", "order": 2, "agent": "knowledge-archivist", "inputs": {"artifacts": ["intent-summary", "completed-scope", "artifact-index", "decision-record", "known-limitations"], "optionalArtifacts": ["lessons-learned", "follow-up-register", "curated-project-record"], "context": ["request", "project", "knowledge"]}, "produces": ["knowledge-record", "next-intent-notes"]}
  ],
  "scopes": {
    "solo": ["analyze", "ideate", "develop", "archived"],
    "team": ["analyze", "ideate", "develop", "launch", "archived"],
    "enterprise": ["analyze", "ideate", "develop", "launch", "curate", "archived"]
  },
  "outputs": {
    "failing-tests": { "kind": "code-manifest" },
    "implementation": { "kind": "code-manifest" },
    "knowledge-record": { "path": ".aidlc/knowledge/{intentId}.md" }
  },
  "agents": [
    {"id": "brief-analyst", "phase": "analyze", "model": "sonnet", "file": "methodology/agents/brief-analyst.md"},
    {"id": "context-risk-analyst", "phase": "analyze", "model": "sonnet", "file": "methodology/agents/context-risk-analyst.md"},
    {"id": "solution-explorer", "phase": "ideate", "model": "opus", "file": "methodology/agents/solution-explorer.md"},
    {"id": "decision-facilitator", "phase": "ideate", "model": "opus", "file": "methodology/agents/decision-facilitator.md"},
    {"id": "implementation-planner", "phase": "develop", "model": "sonnet", "file": "methodology/agents/implementation-planner.md"},
    {"id": "builder-verifier", "phase": "develop", "model": "sonnet", "file": "methodology/agents/builder-verifier.md"},
    {"id": "release-coordinator", "phase": "launch", "model": "sonnet", "file": "methodology/agents/release-coordinator.md"},
    {"id": "operations-handoff", "phase": "launch", "model": "sonnet", "file": "methodology/agents/operations-handoff.md"},
    {"id": "outcome-curator", "phase": "curate", "model": "sonnet", "file": "methodology/agents/outcome-curator.md"},
    {"id": "knowledge-steward", "phase": "curate", "model": "haiku", "file": "methodology/agents/knowledge-steward.md"},
    {"id": "record-keeper", "phase": "archived", "model": "haiku", "file": "methodology/agents/record-keeper.md"},
    {"id": "knowledge-archivist", "phase": "archived", "model": "sonnet", "file": "methodology/agents/knowledge-archivist.md"}
  ]
}
